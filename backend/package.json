{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:wrangler": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute minimalist-db --remote --file=./src/db/init.sql",
    "d1:init:local": "wrangler d1 execute minimalist-db --local --file=./src/db/init.sql && npx wrangler dev",
    "start": "bunx --bun pm2 start pm2.config.cjs",
    "stop": "bunx --bun pm2 stop backend",
    "restart": "bunx --bun pm2 restart backend",
    "delete": "bunx --bun pm2 delete backend",
    "logs": "bunx --bun pm2 logs backend",
    "status": "bunx --bun pm2 status",
    "typecheck": "bun x tsc --noEmit",
    "db:generate": "bun x drizzle-kit generate",
    "db:push": "bun x drizzle-kit push"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241101.0",
    "bun-types": "^1.1.0",
    "drizzle-kit": "^0.27.0",
    "pm2": "^5.4.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.160.0"
  }
}
